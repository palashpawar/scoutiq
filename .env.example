# ScoutIQ configuration. Copy to `.env` (repo root or backend/) and fill in.
# All values are read by the FastAPI backend only; nothing here reaches the browser.

# --- Meta Model API (OpenAI-compatible Chat Completions) -------------------
# Docs: https://dev.meta.ai/docs/protocols/chat-completions
# Leave META_API_KEY empty to run in demo mode (deterministic parser + template summaries).
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
META_MODEL=muse-spark-1.3
# Modal Endpoints (Meta open-weights models) instead of the Meta Model API:
#   META_API_BASE_URL=<your-endpoint-url>/v1
#   META_API_KEY=wk-<token-id>.ws-<token-secret>
#   META_MODEL=<model name from the endpoint's request example>
#   META_REASONING_EFFORT=     (leave empty)
# Optional: reasoning effort sent with each request (leave empty to omit the parameter).
META_REASONING_EFFORT=low
# Per-request timeout in seconds before falling back to demo behaviour.
META_TIMEOUT_SECONDS=25

# --- App -------------------------------------------------------------------
# Force demo mode even if a key is set (useful for offline demos).
SCOUTIQ_DEMO_MODE=
# POST requests allowed per client IP per minute.
SCOUTIQ_RATE_LIMIT_PER_MINUTE=30
# SQLite database built by backend/scripts/ingest.py.
# SCOUTIQ_DB_PATH=backend/data/scoutiq.db

# --- Frontend (Next.js server) ---------------------------------------------
# Where the Next.js server proxies /api/* requests.
# SCOUTIQ_BACKEND_URL=http://127.0.0.1:8000
